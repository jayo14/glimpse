# Database Connection
# Format: postgresql://user:password@host:port/dbname
DATABASE_URL=postgresql://postgres:postgres@db:5432/postgres

# Redis Connection (for ARQ)
# Format: redis://host:port/db
REDIS_URL=redis://redis:6379/0

# Supabase S3 / Storage Configuration
# These are used to download photographer photos and upload guest selfies
SUPABASE_S3_ENDPOINT_URL=http://localhost:54321/storage/v1/s3
SUPABASE_S3_ACCESS_KEY_ID=your_access_key_id
SUPABASE_S3_SECRET_ACCESS_KEY=your_secret_access_key
STORAGE_BUCKET_NAME=event-photos

# Optional: Supabase API Keys (if needed by other services)
SUPABASE_URL=http://localhost:54321
SUPABASE_SERVICE_ROLE_KEY=your_service_role_key

# ML Inference Settings
FACE_SIMILARITY_THRESHOLD=0.35
FACE_DETECTION_THRESHOLD=0.85
MODELS_DIR=models

# CORS Configuration (comma-separated list)
CORS_ORIGINS=*
