# Database URL (Supabase PostgreSQL with pooling)
DATABASE_URL=postgresql://postgres:[PASSWORD]@db.[PROJECT_REF].supabase.co:5432/postgres

# Redis URL (used for ARQ queues)
REDIS_URL=redis://localhost:6379/0

# Supabase URL and Service Role Key
SUPABASE_URL=https://[PROJECT_REF].supabase.co
SUPABASE_SERVICE_ROLE_KEY=[SERVICE_ROLE_KEY]

# Supabase S3 Compatible Endpoint
SUPABASE_S3_ENDPOINT_URL=https://[PROJECT_REF].supabase.co/storage/v1/s3
SUPABASE_S3_ACCESS_KEY_ID=[ACCESS_KEY_ID]
SUPABASE_S3_SECRET_ACCESS_KEY=[SECRET_ACCESS_KEY]

# Storage Configuration
STORAGE_BUCKET_NAME=event-photos

# ML Settings
FACE_SIMILARITY_THRESHOLD=0.35

# CORS Settings (comma-separated list)
CORS_ORIGINS=http://localhost:3000,https://glimpse.example.com
