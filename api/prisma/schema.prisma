generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

enum UserRole {
  HOST
  PHOTOGRAPHER
  GUEST
}

enum ProcessStatus {
  PENDING
  PROCESSING
  COMPLETED
  FAILED
}

enum RoleType {
  PHOTOGRAPHER
  GUEST
}

model Profile {
  id              String               @id @db.Uuid
  full_name       String?
  role            UserRole?
  avatar_url      String?
  // Custom pgvector type mapping matching ArcFace 512-dim embedding
  face_embedding  Unsupported("vector(512)")?
  created_at      DateTime             @default(now()) @map("created_at")

  events          Event[]              @relation("HostEvents")
  collaborations  EventCollaborator[]
  registrations   GuestRegistration[]
  photos          Photo[]

  @@map("profiles")
}

model Event {
  id                String               @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  hostId            String               @map("host_id") @db.Uuid
  title             String
  description       String?
  location          String?
  guestPhotoLimit   Int                  @default(15) @map("guest_photo_limit")
  eventStart        DateTime?            @map("event_start")
  eventEnd          DateTime?            @map("event_end")
  qrCodeUrl         String?              @map("qr_code_url")
  inviteToken       String?              @unique @map("invite_token")
  isActive          Boolean              @default(true) @map("is_active")
  createdAt         DateTime             @default(now()) @map("created_at")

  host              Profile              @relation("HostEvents", fields: [hostId], references: [id], onDelete: Cascade)
  collaborators     EventCollaborator[]
  registrations     GuestRegistration[]
  photos            Photo[]

  @@map("events")
}

model EventCollaborator {
  id                String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  eventId           String   @map("event_id") @db.Uuid
  photographerId    String   @map("photographer_id") @db.Uuid
  assignedAt        DateTime @default(now()) @map("assigned_at")

  event             Event    @relation(fields: [eventId], references: [id], onDelete: Cascade)
  photographer      Profile  @relation(fields: [photographerId], references: [id], onDelete: Cascade)

  @@unique([eventId, photographerId])
  @@map("event_collaborators")
}

model GuestRegistration {
  id            String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  eventId       String   @map("event_id") @db.Uuid
  guestId       String   @map("guest_id") @db.Uuid
  selfiePath    String?  @map("selfie_path")
  shotsUsed     Int      @default(0) @map("shots_used")
  registeredAt  DateTime @default(now()) @map("registered_at")

  event         Event    @relation(fields: [eventId], references: [id], onDelete: Cascade)
  guest         Profile  @relation(fields: [guestId], references: [id], onDelete: Cascade)

  @@unique([eventId, guestId])
  @@map("guest_registrations")
}

model Photo {
  id               String        @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  eventId          String        @map("event_id") @db.Uuid
  uploadedBy       String?       @map("uploaded_by") @db.Uuid
  roleType         RoleType      @map("role_type")
  storagePath      String        @map("storage_path")
  takenAt          DateTime      @default(now()) @map("taken_at")
  processingStatus ProcessStatus @default(PENDING) @map("processing_status")

  event            Event         @relation(fields: [eventId], references: [id], onDelete: Cascade)
  uploader         Profile?      @relation(fields: [uploadedBy], references: [id], onDelete: SetNull)

  @@map("photos")
}